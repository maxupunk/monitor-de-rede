{
  "extends": "@adonisjs/tsconfig/tsconfig.app.json",
  "compilerOptions": {
    "rootDir": "./",
    "outDir": "./build"
  },
  "include": [
    "bin/**/*",
    "app/**/*",
    "config/**/*",
    "database/**/*",
    "start/**/*",
    "commands/**/*",
    "modules/**/*",
    "providers/**/*",
    "tests/**/*",
    "adonisrc.ts",
    "ace.js"
  ],
  "exclude": [
    "frontend",
    "build",
    "node_modules",
    "dist",
    "tmp"
  ]
}
