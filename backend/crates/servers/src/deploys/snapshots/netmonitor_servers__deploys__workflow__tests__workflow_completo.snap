---
source: crates/servers/src/deploys/workflow.rs
expression: yaml
---
# Gerado pelo NetMonitor para SGCv4.
# Compila as imagens, publica no ghcr.io com a tag do commit e avisa a central,
# que decide quando e onde aplicar (aprovação, janela, backup, rollback).
#
# Configure no repositório: Settings → Secrets and variables → Actions →
# Variables → NETMONITOR_URL = endereço público da central (https://…).
# Nenhum segredo é necessário: a central confere o token OIDC do próprio GitHub.
#
# Mantenha os testes do projeto: acrescente o job deles ao `needs` do build.
name: Build e deploy (NetMonitor)

on:
  push:
    branches: ['develop', 'main']
    tags: ['v*']

concurrency:
  group: deploy-${{ github.ref }}
  cancel-in-progress: false

permissions:
  contents: read
  packages: write
  id-token: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      # O ghcr.io só aceita nomes minúsculos.
      - name: Prefixo das imagens
        run: echo "IMAGE_PREFIX=ghcr.io/${GITHUB_REPOSITORY_OWNER,,}" >> "$GITHUB_ENV"

      - uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - uses: docker/setup-buildx-action@v3

      - name: Imagem sgc-api
        uses: docker/build-push-action@v6
        with:
          context: '.'
          file: 'apps/api/Dockerfile'
          push: true
          tags: ${{ env.IMAGE_PREFIX }}/sgc-api:${{ github.sha }}
          cache-from: type=gha,scope=sgc-api
          cache-to: type=gha,mode=max,scope=sgc-api

      - name: Imagem sgc-front-tenants
        uses: docker/build-push-action@v6
        with:
          context: '.'
          file: 'docker/frontend/Dockerfile'
          push: true
          tags: ${{ env.IMAGE_PREFIX }}/sgc-front-tenants:${{ github.sha }}
          cache-from: type=gha,scope=sgc-front-tenants
          cache-to: type=gha,mode=max,scope=sgc-front-tenants

  deploy:
    needs: build
    runs-on: ubuntu-latest
    steps:
      - name: Avisar o NetMonitor
        env:
          NETMONITOR_URL: ${{ vars.NETMONITOR_URL }}
          COMMIT_MESSAGE: ${{ github.event.head_commit.message }}
        run: |
          set -euo pipefail
          TOKEN=$(curl -fsS -H "Authorization: bearer $ACTIONS_ID_TOKEN_REQUEST_TOKEN" \
            "$ACTIONS_ID_TOKEN_REQUEST_URL&audience=netmonitor-deploy" | jq -r .value)
          BODY=$(jq -n --arg message "${COMMIT_MESSAGE:-}" --arg tag "$GITHUB_SHA" \
            '{commitMessage: $message, imageTag: $tag}')
          curl -fsS --retry 3 -X POST "$NETMONITOR_URL/api/deploy-hooks/github" \
            -H "Authorization: Bearer $TOKEN" \
            -H 'Content-Type: application/json' \
            -d "$BODY"
