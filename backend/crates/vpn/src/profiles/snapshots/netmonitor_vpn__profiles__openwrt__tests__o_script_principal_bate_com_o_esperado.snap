---
source: crates/vpn/src/profiles/openwrt.rs
expression: artifact.content
---
# === NetMonitor - WireGuard - filial-01 ===
if command -v apk >/dev/null 2>&1; then   # OpenWrt 24.10+ / SNAPSHOT
  apk update && apk add wireguard-tools luci-proto-wireguard
else                                      # OpenWrt 23.05 e anteriores
  opkg update && opkg install wireguard-tools luci-proto-wireguard
fi

# Limpa uma instalacao anterior (repetir o script nao duplica nada)
uci -q delete network.wg_nm
while uci -q delete 'network.@wireguard_wg_nm[0]'; do :; done

uci set network.wg_nm=interface
uci set network.wg_nm.proto='wireguard'
uci set network.wg_nm.private_key='CHAVE-PRIVADA-DO-CLIENTE'
uci set network.wg_nm.mtu='1420'
uci add_list network.wg_nm.addresses='10.8.0.11/24'

uci set network.wg_nm_server=wireguard_wg_nm
uci set network.wg_nm_server.public_key='CHAVE-PUBLICA-DO-SERVIDOR'
uci set network.wg_nm_server.preshared_key='CHAVE-PRE-COMPARTILHADA'
uci set network.wg_nm_server.endpoint_host='vpn.exemplo.com.br'
uci set network.wg_nm_server.endpoint_port='51820'
uci set network.wg_nm_server.persistent_keepalive='25'
uci set network.wg_nm_server.route_allowed_ips='1'
uci add_list network.wg_nm_server.allowed_ips='10.8.0.0/24'

# Zona de firewall permitindo o monitoramento do NetMonitor
for s in $(uci -q -X show firewall | sed -n "s/^firewall\.\([^.=]*\)\.name='vpn_netmonitor'$/\1/p"); do uci -q delete "firewall.$s"; done
uci set firewall.vpn_netmonitor=zone
uci set firewall.vpn_netmonitor.name='vpn_netmonitor'
uci set firewall.vpn_netmonitor.input='ACCEPT'
uci set firewall.vpn_netmonitor.output='ACCEPT'
uci set firewall.vpn_netmonitor.forward='REJECT'
uci add_list firewall.vpn_netmonitor.network='wg_nm'

uci commit network && uci commit firewall
/etc/init.d/network restart && /etc/init.d/firewall restart
