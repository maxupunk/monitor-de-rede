# Local Configuration (Sensitive/Environment Specific)
**/config/local.yaml
**/config/*.local.yaml

# Master Key (Loco sensitive key)
master.key

# Generated by Cargo (compiled files and executables)
debug/
target/

# Cargo Lockfile included
!Cargo.lock

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds debugging information
*.pdb

# SQLite Databases & temporary journal/WAL files
*.sqlite
*.sqlite3
*.sqlite-*

# Insta test snapshot proposals
*.snap.new
