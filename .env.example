# ---------------------------------------------------------------------------
# NetMonitor — variáveis de ambiente
# ---------------------------------------------------------------------------
# O backend é Rust (Loco.rs). A configuração viva está em
# `backend-rust/config/{development,test,production}.yaml`; este arquivo só
# preenche os `get_env(...)` desses YAMLs e as substituições do
# `docker-compose.yml`. Variável que não aparece aqui não é lida por ninguém.
#
# Ambiente: `LOCO_ENV` escolhe qual YAML vale (development | test | production).
# O compose já injeta `LOCO_ENV=production` nos containers.
LOCO_ENV=development
TZ=UTC
# Nível do logger (`trace|debug|info|warn|error`).
LOG_LEVEL=info
# Intervalo do ciclo do scheduler, em segundos.
SCHEDULER_INTERVAL_SECONDS=5

# ---------------------------------------------------------------------------
# Portas publicadas no HOST pelo docker-compose
# ---------------------------------------------------------------------------
# Afetam apenas o acesso a partir da sua máquina. Dentro da rede
# `netmonitor-net` os containers conversam nas portas padrão (80, 3333, 5432),
# então mudar estes valores nunca quebra a comunicação entre os serviços.
# Use portas livres se você roda vários projetos em paralelo.
FRONTEND_EXTERNAL_PORT=8081
API_EXTERNAL_PORT=3333
POSTGRES_EXTERNAL_PORT=5433

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# O Loco lê uma URL única — não existem DB_HOST/DB_USER/DB_DATABASE separados.
# Dentro do compose a URL já vem injetada (host `postgres`, porta 5432).
# Rodando a API na máquina contra o Postgres do compose, use 127.0.0.1 e a
# POSTGRES_EXTERNAL_PORT acima:
DATABASE_URL=postgres://netmonitor:secret@127.0.0.1:5433/netmonitor
# Pool (opcionais; os padrões estão nos YAMLs de config)
# DB_CONNECT_TIMEOUT=500
# DB_IDLE_TIMEOUT=500
# DB_MIN_CONNECTIONS=1
# DB_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Segredos
# ---------------------------------------------------------------------------
# Assinatura dos JWT de autenticação. TROQUE EM PRODUÇÃO.
# ⚠️ PRECISA ser base64 válido: o Loco assina com
# `EncodingKey::from_base64_secret` (HS512). Um valor que não seja base64 —
# qualquer coisa com `_`, `-` ou comprimento fora de múltiplo de 4 — faz a
# geração do token falhar e **todo login responde 401**, com a mesma mensagem
# de senha inválida. É um erro caro de diagnosticar; não improvise aqui.
# Gere um novo (PowerShell):
#   $b = New-Object byte[] 64
#   [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b)
#   [Convert]::ToBase64String($b)
JWT_SECRET=Y2hhbmdlLW1lLXRoaXMtaXMtYS1wbGFjZWhvbGRlci1zZWNyZXQtdmFsdWUtMDAwMQ==
# Cifra em repouso dos segredos da VPN — exatamente 32 caracteres.
# Trocar esta chave torna ilegível tudo que já foi cifrado com a anterior.
APP_KEY=secret_app_key_32_characters_long_str

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
# Host anunciado pelo servidor (`server.host` do config de produção).
APP_URL=http://localhost
# Origem liberada no CORS. Em dev é o Vite; em Docker, a porta do frontend.
FRONTEND_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Módulo VPN (WireGuard)
# ---------------------------------------------------------------------------
# Porta UDP publicada pelo container WireGuard. É mapeada 1:1 (host = container)
# porque é o Endpoint usado pelos roteadores — mantenha o mesmo valor no campo
# "Porta UDP" da tela /vpn. Precisa de port-forward se o servidor estiver atrás de NAT.
WG_EXTERNAL_PORT=51820
# Diretório do volume compartilhado onde a API escreve o wg0.conf.
# Em Windows, sem Docker, o padrão é ./tmp/wireguard
WG_CONFIG_DIR=/config
# Nome do probe dedicado (precisa bater com o registro no banco)
VPN_PROBE_NAME=vpn-probe
# Token do probe dedicado da VPN.
# Gere um novo com: backend_rust-cli task vpn_probe_register
VPN_PROBE_TOKEN=default_vpn_probe_token

# ---------------------------------------------------------------------------
# Probe (agente de coleta)
# ---------------------------------------------------------------------------
# Onde o probe procura o servidor. Dentro do compose é http://server:3333.
# PROBE_SERVER_URL=http://localhost:3333
# Token do probe da LAN; gere com: backend_rust-cli task probe_register
# PROBE_TOKEN=
# Arquivo de buffer usado quando o servidor está fora do ar.
# PROBE_BUFFER_PATH=

# ---------------------------------------------------------------------------
# Políticas de retenção e limpeza de dados (em dias)
# ---------------------------------------------------------------------------
# A purga roda dentro do ciclo do scheduler (`task scheduler_loop`), a cada 1h,
# não em processo separado. Valor 0 ou inválido cai no padrão — desligar a purga
# por engano encheria o disco.
RETENTION_MONITOR_RESULTS_DAYS=14
RETENTION_METRICS_DAYS=30
RETENTION_DISCOVERY_DAYS=7

# ---------------------------------------------------------------------------
# Canais de notificação (todos opcionais; em branco = canal desligado)
# ---------------------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DISCORD_WEBHOOK_URL=
# GENERIC_WEBHOOK_URL=
# SMTP_TO=
