TZ=UTC
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
APP_KEY=secret_app_key_32_characters_long_str
APP_URL=http://localhost:3333
SESSION_DRIVER=cookie
NODE_ENV=development

# ---------------------------------------------------------------------------
# Portas publicadas no HOST pelo docker-compose
# ---------------------------------------------------------------------------
# Afetam apenas o acesso a partir da sua máquina. Dentro da rede `netmonitor-net`
# os containers continuam conversando nas portas padrão (80, 3333, 5432, 6379),
# então mudar estes valores nunca quebra a comunicação entre os serviços.
# Redis não publica porta externa: só server/worker/scheduler o acessam, via rede interna.
#
# Use portas livres se você roda vários projetos em paralelo.
# Defina '0' para o Docker escolher uma porta aleatória disponível.
FRONTEND_EXTERNAL_PORT=8081
API_EXTERNAL_PORT=3333
POSTGRES_EXTERNAL_PORT=5433

# ---------------------------------------------------------------------------
# Conexão da aplicação com o banco e o Redis
# ---------------------------------------------------------------------------
# ATENÇÃO: estes valores são de CONEXÃO, não de publicação.
#  - Rodando tudo em Docker: o compose já injeta DB_HOST=postgres e DB_PORT=5432.
#  - Rodando a API local (npm run dev) contra o Postgres do compose:
#    use DB_HOST=127.0.0.1 e DB_PORT igual ao POSTGRES_EXTERNAL_PORT acima.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=secret
DB_DATABASE=netmonitor

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Módulo VPN (WireGuard) ---
# Porta UDP publicada pelo container WireGuard. É mapeada 1:1 (host = container)
# porque é o Endpoint usado pelos roteadores — mantenha o mesmo valor no campo
# "Porta UDP" da tela /vpn. Precisa de port-forward se o servidor estiver atrás de NAT.
WG_EXTERNAL_PORT=51820
# Diretório do volume compartilhado onde a API escreve o wg0.conf.
# Em Windows, sem Docker, o padrão é ./tmp/wireguard
WG_CONFIG_DIR=/config
# Token do probe dedicado que monitora pelo túnel (gere com: node ace vpn:probe-register)
VPN_PROBE_TOKEN=
# Nome do probe dedicado (precisa bater com o registro no banco)
VPN_PROBE_NAME=vpn-probe