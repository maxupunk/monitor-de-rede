#!/usr/bin/with-contenv bash
# Sobe o watcher de hot-reload em segundo plano durante a inicialização do
# container (padrão de init customizado das imagens linuxserver.io).
set -u

WATCHER="/custom-scripts/netmonitor-watcher.sh"

if [ ! -f "${WATCHER}" ]; then
  echo "[netmonitor] watcher não encontrado em ${WATCHER}"
  exit 0
fi

echo "[netmonitor] iniciando watcher de hot-reload do WireGuard"
nohup bash "${WATCHER}" >/config/netmonitor-watcher.log 2>&1 &
